PORT=3000
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGDATABASE=myshopzy
PGUSER=your_postgres_user
PGPASSWORD=replace_with_your_local_password

# Development-only customer login. The OTP is provided out of band; no message is sent.
DEVELOPMENT_CUSTOMER_OTP=replace_with_six_digit_dev_code
DEVELOPMENT_CUSTOMER_SESSION_SECRET=replace_with_at_least_32_random_characters
