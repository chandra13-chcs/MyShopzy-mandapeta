PORT=3000
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGDATABASE=myshopzy
PGUSER=your_postgres_user
PGPASSWORD=replace_with_your_local_password

# Development-only customer login. The OTP is provided out of band; no message is sent.
DEVELOPMENT_CUSTOMER_OTP=replace_with_six_digit_dev_code
DEVELOPMENT_CUSTOMER_SESSION_SECRET=replace_with_at_least_32_random_characters

# Backend-only customer OTP authentication. Use a Meta-approved WhatsApp
# Authentication template with a copy-code OTP button; provision real values
# through the backend secret manager, never Flutter build-time defines.
CUSTOMER_OTP_PEPPER=replace_with_at_least_32_random_characters
CUSTOMER_SESSION_SECRET=replace_with_at_least_32_random_characters
WHATSAPP_ACCESS_TOKEN=replace_with_backend_only_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_business_phone_number_id
WHATSAPP_OTP_TEMPLATE_NAME=replace_with_approved_authentication_template_name
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v25.0

# Super Admin Auth0 API verification. Routes stay unmounted until all are set.
AUTH0_ISSUER_URL=
AUTH0_AUDIENCE=
AUTH0_ADMIN_USER_ID_CLAIM=
AUTH0_PARTNER_EMAIL_CLAIM=email
AUTH0_PARTNER_EMAIL_VERIFIED_CLAIM=email_verified
SUPER_ADMIN_ORIGIN=http://localhost:5174
# Configure Auth0 to issue the selected email and verified-email claims in access tokens.
PARTNER_PORTAL_ORIGINS=http://localhost:5173
